#include <winres.h>
#include "../src/resource.h"

IDI_APP         ICON "app.ico"
IDI_APP_PAUSED  ICON "app_paused.ico"
IDI_APP_EDIT    ICON "app_edit.ico"
IDR_LOGO        RCDATA "logo.png"
IDR_WR_ATLAS    RCDATA "wetrash/atlas.png"
IDR_WR_MASKS    RCDATA "wetrash/masks.png"
IDR_WR_SATLAS   RCDATA "wetrash/side_atlas.png"
IDR_WR_SMASKS   RCDATA "wetrash/side_masks.png"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "Player.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,6,0,0
 PRODUCTVERSION 0,6,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Divaverse"
            VALUE "FileDescription", "Divaverse"
            VALUE "FileVersion", "0.6.0.0"
            VALUE "InternalName", "DivaversePlayer"
            VALUE "OriginalFilename", "Divaverse.exe"
            VALUE "ProductName", "Divaverse"
            VALUE "ProductVersion", "0.6.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
